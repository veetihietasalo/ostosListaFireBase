# Optional. Copy to .env and fill in from the Firebase console (Project settings > Your apps >
# Web app config) to use a Realtime Database. Left empty, the app runs in demo mode on a local
# list. .env is git-ignored. Expo inlines EXPO_PUBLIC_ values into the app bundle, so anyone with
# the app can read them. That's normal for a Firebase web config, the Realtime Database rules are
# what protect the data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
